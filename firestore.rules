rules_version = '2';
// Reglas de seguridad de Firestore. Se pegan a mano en:
// consola de Firebase → Firestore Database → Reglas → Publicar.
service cloud.firestore {
  match /databases/{database}/documents {

    // Cuentas con acceso. Para sumar a alguien, agregar su email a la lista.
    function permitido() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['eldiego87@gmail.com'];
    }

    // Cada usuario solo ve y modifica lo suyo: su configuración y sus colecciones.
    match /usuarios/{uid} {
      allow read, write: if permitido() && request.auth.uid == uid;

      match /{coleccion}/{id} {
        allow read, write: if permitido() && request.auth.uid == uid
          && coleccion in ['productos', 'clientes', 'cotizaciones'];
      }
    }
  }
}
